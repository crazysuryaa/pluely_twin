{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pluely-twin-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "durable_objects": {
    "bindings": [
      {
        "name": "TWIN_SESSIONS",
        "class_name": "TwinSession"
      }
    ]
  },
  "exports": {
    "TwinSession": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "ratelimits": [
    {
      "name": "SESSION_CREATE_LIMITER",
      "namespace_id": "10001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "vars": {
    "TWIN_RELAY_SESSION_TTL_SECONDS": "28800",
    "TWIN_RELAY_MAX_EVENTS": "5000",
    "TWIN_RELAY_MAX_COMMENTS": "5000"
  }
}
